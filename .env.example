# Hearth configuration. Every value below is optional: the app ships working
# defaults, so `python -m app.server` runs with no .env file at all.

# HTTP port (PORT wins if your process manager sets it; both default to 8000).
APP_PORT=8000
PORT=8000

# Bind address. 0.0.0.0 makes the start page reachable from the rest of the LAN.
APP_HOST=0.0.0.0

# Where hearth.db lives (created automatically on first boot).
DATA_DIR=./data

# Session lifetime in days.
SESSION_TTL_DAYS=30

# Set to 0 to skip the post-boot health check of the seeded "Hearth (this page)" tile.
HEARTH_BOOT_PROBE=1

# Demo account credentials. Leave these commented out (or empty) to use the
# documented demo login printed on the sign-in card. Set your own values - or
# remove the seeded accounts - before exposing Hearth beyond your own LAN.
# HEARTH_DEMO_EMAIL=
# HEARTH_DEMO_PASSWORD=
# HEARTH_SECOND_DEMO_EMAIL=
# HEARTH_SECOND_DEMO_PASSWORD=

# Where Hearth reaches itself (used by the seeded self-probe tile and the
# startup log). Defaults to http://127.0.0.1:$PORT. Set HEARTH_BASE_URL, or the
# host, when Hearth runs behind a reverse proxy or on another machine.
# HEARTH_BASE_URL=
# HEARTH_PROBE_HOST=127.0.0.1
# HEARTH_SELF_PROBE_URL=
